# 스테이징된 파일에만 eslint --fix와 prettier --write를 돌린다.
#
# lint-staged를 쓰지 않는다. Windows에서 node_modules/.bin 래퍼를 실행하는 태스크가
# 시작만 하고 끝나지 않는다(#53). eslint뿐 아니라 prettier도 같고, 16.x로 낮춰도 같다.
# 같은 파일 목록을 셸에서 직접 돌리면 15초에 끝나고, 설정을
# `node ./node_modules/eslint/bin/eslint.js --fix`처럼 .bin을 거치지 않게 바꾸면 그것도 끝난다.

set -e

staged() {
  git diff --cached --name-only --diff-filter=ACMR -- "$@"
}

# eslint --fix와 prettier --write는 인덱스가 아니라 작업 트리를 고친다.
# 한 파일에서 일부 hunk만 스테이징했다면 뒤이은 git add가 나머지까지 끌어와
# 의도하지 않은 변경이 커밋에 섞인다. 그런 파일이 있으면 여기서 멈춘다.
PARTIAL=$(git status --porcelain | grep -E '^[MARC][MD]' | cut -c4-)
if [ -n "$PARTIAL" ]; then
  echo "부분 스테이징된 파일이 있어 커밋을 멈춥니다."
  echo "$PARTIAL" | sed 's/^/  /'
  echo
  echo "포맷·린트가 파일 전체를 고치므로 스테이징하지 않은 변경까지 커밋에 섞입니다."
  echo "파일 전체를 스테이징하거나(git add <파일>), 나머지를 따로 치워두고 다시 시도하십시오."
  exit 1
fi

TS_FILES=$(staged '*.ts' '*.tsx')
if [ -n "$TS_FILES" ]; then
  echo "$TS_FILES" | xargs npx eslint --fix
  echo "$TS_FILES" | xargs git add
fi

FMT_FILES=$(staged '*.ts' '*.tsx' '*.css' '*.json' '*.jsonc' '*.mjs' '*.mts' '*.yml' '*.yaml' '.prettierrc')
if [ -n "$FMT_FILES" ]; then
  echo "$FMT_FILES" | xargs npx prettier --write --ignore-unknown
  echo "$FMT_FILES" | xargs git add
fi
