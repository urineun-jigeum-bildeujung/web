# 이 파일을 복사해 .env.local을 만든다. (cp .env.example .env.local)
# 변수를 추가하면 env.d.ts의 ProcessEnv 타입도 함께 갱신한다.

# PRIVATE — 서버에서만 읽는 값. 브라우저 번들에 포함되지 않는다.

# 행정안전부 도로명주소 검색 API 승인키. juso.go.kr에서 발급받는다.
# NEXT_PUBLIC_을 붙이면 브라우저 번들에 박혀 키가 노출된다. Route Handler에서만 읽는다.
JUSO_CONFM_KEY=

# 서버 런타임(RSC 등)에서 apiRequest가 쓰는 절대 URL. 서버의 fetch는 same-origin 상대 경로를
# 못 풀어 NEXT_PUBLIC_API_BASE_URL의 "/api/v1" fallback을 쓸 수 없다 — 없으면 apiRequest가
# 바로 오류를 던진다. Jenkins 빌드 시점이 아니라 GitOps가 실행 중인 컨테이너에 주입해야 한다.
# API_BASE_URL_INTERNAL=http://localhost:8080/api/v1


# PUBLIC — NEXT_PUBLIC_ 접두사를 붙인다. 브라우저에 노출되므로 비밀값 금지.

# 백엔드 API base URL. 비우면 same-origin /api/v1을 쓴다.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 소셜 로그인 시작 주소의 base. 비우면 same-origin /api/auth를 쓴다.
# **일반 API와 경로가 다르다.** 게이트웨이가 /api/v1/**과 별개로
# /api/auth/oauth2/authorization/**를 OAuth2 클라이언트로 보내기 때문에
# NEXT_PUBLIC_API_BASE_URL에서 파생할 수 없다.
# NEXT_PUBLIC_OAUTH_BASE_URL=http://localhost:8080/api/auth

# 토스페이먼츠 결제위젯 클라이언트 키. 결제 UI를 띄우는 데 쓰고 브라우저에 노출되는 것이 정상이다.
# **백엔드가 쓰는 테스트 상점의 키를 받아서 넣는다.** 클라이언트 키와 승인용 시크릿 키는
# 한 상점의 세트라, 짝이 안 맞으면 결제창은 떠도 승인에서 INVALID_API_KEY가 난다.
# 접두사가 test_gck_여야 한다 — test_ck_는 API 개별 연동용이라 위젯이 뜨지 않는다.
# 시크릿 키는 백엔드가 쥐므로 여기 두지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# DEMO — 작성 방식을 보여주는 예시. 실제 변수가 생기면 위 규칙대로 추가한다.
DEMO=demo
